// The records the data module (app.ts) answers and the parts draw. A shape has no optional field: a value that may be
// missing is an empty string, zero or an empty list. Every `at` is a time in milliseconds since 1970.

shape Time
  epochAtZero: number
  utcOffset: number

// What the binary knows of its updates (`exactDelivery()`): the number of the update that runs, and whether a newer one
// is downloaded and waits to apply.
shape DeliveryState
  seq: number
  staged: bool

// Where a message can go: an agent, which the app calls a project.
shape Project
  id: string
  name: string
  letter: string
  face: number

// One row of Needs attention: a rule that breaches, how many things breach it, the chat that holds the fix, and the
// symbol of the rule. `value` is the big number of the row.
shape Attention
  id: string
  chat: string
  label: string
  detail: string
  value: string
  count: number
  symbol: string

// One row of the list of chats. `status` is needs_you, working, health or idle: it picks what the line under the name
// is, and the line holds its words.
shape ChatRow
  id: string
  kind: string
  title: string
  letter: string
  face: number
  circle: bool
  line: string
  status: string
  active: bool
  unread: number
  at: number

// `live` is true when the chats come from the Mac, and `banner` says why they may be old (a connection that failed).
shape Home
  target: Project
  projects: Project[]
  attention: Attention[]
  chats: ChatRow[]
  live: bool
  banner: string

shape Choice
  id: string
  label: string
  explanation: string

// A line of a chat. `kind` is text, activity, decision, artifact, notice or status; the working line is the last row
// of a chat whose agent works. A decision has its `ref`, its `status` (pending or replied) and the `receipt` of the
// option that was chosen.
shape Message
  id: string
  kind: string
  mine: bool
  author: string
  at: number
  title: string
  body: string
  detail: string
  ref: string
  status: string
  receipt: string
  options: Choice[]

// What the agent of a chat does now. `startedAt` is the start of the turn, `queued` the messages that wait for the next.
shape Turn
  running: bool
  startedAt: number
  phase: string
  detail: string
  model: string
  queued: number

// `live` is a chat of the Mac. `toolbar` opens the box of the composer under a long draft (ComposerExpansion).
shape Chat
  id: string
  kind: string
  title: string
  project: string
  letter: string
  face: number
  circle: bool
  messages: Message[]
  turn: Turn
  toolbar: bool
  live: bool

// A row of the slash menu over the message box (ComposerSlash): a command to complete (`kind` complete, `value` the
// text it completes to), or a model or an effort to choose (`value` the model's key or the effort). `chosen` marks the
// one every chat runs with now.
shape Suggestion
  id: string
  kind: string
  value: string
  title: string
  detail: string
  symbol: string
  chosen: bool

shape Ack
  ok: bool

// The reply of a write that makes a thing: the id of the chat or of the project.
shape Made
  id: string

// The pairing that this phone keeps (app.ts keeps the keys in the Keychain): whether there is one, and the name of the Mac.
shape Saved
  paired: bool
  macName: string

// The pairing code that this phone shows: the person sends `pair <code>` to their Hermes, which seals a setup for the
// rendezvous box of the code on the relay. `id` is the box.
shape PairCode
  code: string
  id: string
  error: string

// The box of a pairing code: `waiting`, `ready` (a setup came, so the phone pairs), `expired` or `error`.
shape PairState
  status: string
  id: string
  macName: string
  error: string

// The socket of one connection to the relay: `connecting`, `open` or `closed`, and how many events it had.
shape Sock
  key: string
  status: string
  n: number

// The last sync with the Mac: the version of the state, the pairings made, and the error of the last try.
shape Live
  version: number
  pairs: number
  error: string
