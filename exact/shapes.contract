// The records the data module (app.ts) answers and the parts draw. A shape has no optional field: a value that may be
// missing is an empty string, zero or an empty list. Every `at` is a time in milliseconds since 1970.

shape Time
  epochAtZero: number
  utcOffset: number

// What the binary knows of its updates (`exactDelivery()`): the number of the update that runs, and whether a newer one
// is downloaded and waits to apply.
shape DeliveryState
  seq: number
  staged: bool

// Where a message can go: an agent, which the app calls a project.
shape Project
  id: string
  name: string
  letter: string
  face: number

// One row of Needs attention: a rule that breaches, how many things breach it, the chat that holds the fix, and the
// symbol of the rule. `value` is the big number of the row.
shape Attention
  id: string
  chat: string
  label: string
  detail: string
  value: string
  count: number
  symbol: string

// One row of the list of chats. `status` is needs_you, working, health or idle: it picks what the line under the name
// is, and the line holds its words. `step` is the start of the step that a working chat does now, or 0: the row then
// shows the time since that step started in place of the age of its newest message (ChatRowLayout.step).
shape ChatRow
  id: string
  kind: string
  title: string
  letter: string
  face: number
  circle: bool
  line: string
  status: string
  active: bool
  unread: number
  at: number
  step: number

// `live` is true when the chats come from the Mac, and `banner` says why they may be old (a connection that failed).
shape Home
  target: Project
  projects: Project[]
  attention: Attention[]
  chats: ChatRow[]
  live: bool
  banner: string

// A photo of a chat or of a card (MessagePhoto, DecisionPreview). `src` is what a tile shows: a small copy that the
// phone keeps of a file of the Mac (app:/tmp/upload/photos), a web address, or a picture of the app's assets; empty
// while it loads. `full` is the picture that the viewer shows. `state` is loading, ready or failed. `width` and
// `height` are the size that a card names for its preview, else 0.
shape Photo
  key: string
  src: string
  full: string
  caption: string
  state: string
  width: number
  height: number

// An option of a card (DecisionChoiceContent): the label, what it does, whether the agent recommends it, and its risk
// (`risk` the label, such as Low risk, and `reason` why). `approve` options wait for the previews of the card.
shape Choice
  id: string
  label: string
  explanation: string
  recommended: bool
  risk: string
  reason: string
  approve: bool

// The message that a draft card sends once the person chooses Send (MessageDraftContent). An empty field shows no row.
shape Draft
  via: string
  from: string
  to: string
  replyTo: string
  subject: string
  body: string

// A card of a chat (DecisionCard). `context` holds its paragraphs, `sources` a line for each source, `risk` and `reason`
// its assessment, and `drafts` the message of a draft card (none or one). `pending` shows the options, else the
// receipt: its words, its mark (a symbol, or empty) and whether it is dimmed, for a card that closed without a choice.
// `chosen` is the option that the person picked: while `waiting` the answer waits for its Undo, while `sending` it goes
// to the Mac. `error` says why the last answer did not go. `revision` is the revision of the card as it shows, which a
// choice, the X and the sheet of Edit draft name.
shape Card
  ref: string
  title: string
  sources: string[]
  diff: string
  context: string[]
  risk: string
  reason: string
  stale: bool
  previews: Photo[]
  previewsReady: bool
  drafts: Draft[]
  options: Choice[]
  pending: bool
  refreshing: bool
  dismissible: bool
  chosen: string
  chosenLabel: string
  waiting: bool
  sending: bool
  receipt: string
  mark: string
  dim: bool
  outcome: string
  earlier: string
  revised: bool
  error: string
  revision: number

// A row of a chat. `kind` is text, photos, activity, decision, artifact, document, process, notice or status; the
// working line is the last row of a chat whose agent works. `startsDay` puts the day above the row, and `newLine` the
// New line of the messages that came since the person last read the chat. `sender` names who wrote a message of an
// agent to another agent, `quote` and `quoteAuthor` the message that it answers. `photos` are the photos of a row of
// photos, and `card` the card of a decision row (none or one). A process row is a background process of Hermes that
// ended: `title` its name, `body` how it ended with its run time, `detail` the command, or the last output of a
// failure, and `failed` whether it failed.
shape Message
  id: string
  kind: string
  mine: bool
  author: string
  at: number
  title: string
  body: string
  detail: string
  failed: bool
  startsDay: bool
  newLine: bool
  sender: string
  quote: string
  quoteAuthor: string
  photos: Photo[]
  card: Card[]

// What the agent of a chat does now. `startedAt` is the start of the turn, `queued` the messages that wait for the next.
// `writing` is true in the phase Writing…, when the working line juggles (BotStatusRow).
shape Turn
  running: bool
  startedAt: number
  phase: string
  writing: bool
  detail: string
  model: string
  queued: number

// A message that waits for the next turn of a working chat (MessageQueue). `preview` is its first line, or the count of
// its files when it has no words; `text` is its words, empty for files alone; `attachments` counts its files. `state` is
// queued, steering (it went to the running turn and waits for it to take it) or sending (the phone sent it and the Mac
// has yet to hold it). `canChange` is a message to edit, move or remove; `canSteer` one the running turn can take now.
shape Queued
  id: string
  position: number
  preview: string
  text: string
  attachments: number
  state: string
  canChange: bool
  canSteer: bool
  canMoveUp: bool
  canMoveDown: bool

// `live` is a chat of the Mac. `toolbar` opens the box of the composer under a long draft (ComposerExpansion). `missing`
// counts the photos of the chat that the phone has yet to load from the Mac (`loadMedia`). `muted` is a chat that sends
// no push (BotChatMute). `queue` holds the messages that wait for the next turn, oldest first, and `newAgent` is a chat
// whose queued message can go to a new chat of its agent instead (every agent but Coconut).
shape Chat
  id: string
  kind: string
  title: string
  project: string
  letter: string
  face: number
  circle: bool
  messages: Message[]
  turn: Turn
  toolbar: bool
  live: bool
  missing: number
  muted: bool
  queue: Queued[]
  newAgent: bool

// The facts of the screen that the app reads: Reduce Motion keeps the coconut that waits still (CoconutLoader).
shape Viewport
  prefersReducedMotion: bool

// The photos that the phone loaded from the Mac for the open chat: `n` moves with each, so the chat reads them.
shape Media
  n: number
  missing: number

// A row of the slash menu over the message box (ComposerSlash): a command to complete (`kind` complete, `value` the
// text it completes to), or a model or an effort to choose (`value` the model's key or the effort). `chosen` marks the
// one every chat runs with now.
shape Suggestion
  id: string
  kind: string
  value: string
  title: string
  detail: string
  symbol: string
  chosen: bool

shape Ack
  ok: bool

// The reply of Save in the sheet of a draft card (MessageDraftEditor): whether the Mac kept the new message, and else
// why not, in the Mac's words.
shape Edited
  ok: bool
  error: string

// The reply of a write that makes a thing: the id of the chat or of the project.
shape Made
  id: string

// The pairing that this phone keeps (app.ts keeps the keys in the Keychain): whether there is one, and the name of the Mac.
shape Saved
  paired: bool
  macName: string

// The pairing code that this phone shows: the person sends `pair <code>` to their Hermes, which seals a setup for the
// rendezvous box of the code on the relay. `id` is the box.
shape PairCode
  code: string
  id: string
  error: string

// The box of a pairing code: `waiting`, `ready` (a setup came, so the phone pairs), `expired` or `error`.
shape PairState
  status: string
  id: string
  macName: string
  error: string

// The socket of one connection to the relay: `connecting`, `open` or `closed`, and how many events it had.
shape Sock
  key: string
  status: string
  n: number

// The last sync with the Mac: the version of the state, the pairings made, the error of the last try, and whether the
// next round may come soon, because this round's session read the Mac before it ended. A socket that closed after such
// a read gives way at once (`retryingNow`).
shape Live
  version: number
  pairs: number
  error: string
  quick: bool

// What the phone finds for the words of the search field of Home (OmniSearch): `q` is the search it answers, `chats`
// the chats whose names have its words, `cards` the cards that wait whose titles have them, and `messages` the text
// messages that have every word, newest first.
shape Found
  q: string
  chats: ChatRow[]
  cards: FoundCard[]
  messages: FoundMessage[]

// A card that waits, found by its title: `chat` holds it, `row` is the row of that chat that shows it (empty when the
// phone has none), and `detail` is the name of that chat, or Waiting.
shape FoundCard
  id: string
  chat: string
  title: string
  detail: string
  row: string

// A message of a search (OmniSearch.MessageHit): its chat and the name of the chat, its time, and its words around the
// first word of the search, cut in runs where each word of the search is `hit`. `continued` is a message in the chat of
// the one above it, whose row leaves out the name.
shape FoundMessage
  id: string
  chat: string
  name: string
  at: number
  runs: Span[]
  continued: bool

shape Span
  text: string
  hit: bool

// The messages of a search with those that the Mac finds (GET /v1/search), newest first.
shape MacFound
  q: string
  messages: FoundMessage[]
