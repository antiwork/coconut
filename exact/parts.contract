// The parts of Coconut's screens: a face, a count, a row of the list of chats, a row of Needs attention, the rows of a
// search (the title of a group, a card, a message and its words), the rows of a chat (a message, a photo, a card and
// its options, a file, a page of the Library, a background process, a notice, the day and the New line), the
// working line and a row of the queue. A part draws what it is given. An action is the caller's: a part takes one as a prop, already bound to
// its item (`choose=openChat(c.id)`), as ItemSections does in the list-detail pattern.
use Attention, Card, ChatRow, Choice, Draft, FoundCard, FoundMessage, Message, Photo, Queued, Turn from "./shapes.contract"
use CoconutLoader from "./loader.contract"

// The time of a turn to the second, without leading zeros: 9s, 4m 5s, 1h 2m 5s (ConversationActivity.elapsed).
fn elapsed(ms: number): string = ms < 60000 ? `${floor(max(ms, 0) / 1000)}s` : ms < 3600000 ? `${floor(ms / 60000)}m ${floor(ms / 1000) % 60}s` : `${floor(ms / 3600000)}h ${floor(ms / 60000) % 60}m ${floor(ms / 1000) % 60}s`
// The count of an unread badge: over 99 shows 99+ (UnreadBadge.text).
fn badgeText(n: number): string = n > 99 ? "99+" : `${n}`
// The colours of a face: the eight of app.forma, written out (see app.contract).
fn faceFill(i: number): string = i == 0 ? "#7e99d3" : i == 1 ? "#70a779" : i == 2 ? "#aa79c2" : i == 3 ? "#f2a088" : i == 4 ? "#eaa052" : i == 5 ? "#d76c91" : i == 6 ? "#b6c493" : "#ebc96c"
fn faceInk(i: number): string = i == 0 ? "#1f334e" : i == 1 ? "#fcedce" : i == 2 ? "#fcf0dd" : i == 3 ? "#263329" : i == 4 ? "#263329" : i == 5 ? "#ffebd6" : i == 6 ? "#263329" : "#263329"
// The day of an instant as a key in the zone of the person; two keys are the same day when they are equal.
fn dayKey(ms: number, offset: number): string = formatDate(ms, offset, "iso")
// The time of a message, as MessageTimes.label shows it: 4:02 PM today, Yesterday 4:02 PM, Mon 4:02 PM within six days,
// else Nov 3, 4:02 PM.
fn messageTime(at: number, now: number, offset: number): string = dayKey(at, offset) == dayKey(now, offset) ? formatTime(at, offset, "short") : dayKey(at, offset) == dayKey(now - 86400000, offset) ? `Yesterday ${formatTime(at, offset, "short")}` : now - at < 518400000 ? `${formatDay(at, now, offset, "day").slice(0, 3)} ${formatTime(at, offset, "short")}` : `${formatDate(at, offset, "month-day")}, ${formatTime(at, offset, "short")}`
// The age of a row of a list: Now under a minute, then 4 min and 3 hr, and from a day on the date, Nov 3
// (CompactAgeLabel).
fn compactAge(at: number, now: number, offset: number): string = now - at < 60000 ? "Now" : now - at < 3600000 ? `${floor((now - at) / 60000)} min` : now - at < 86400000 ? `${floor((now - at) / 3600000)} hr` : formatDate(at, offset, "month-day")
// BoardStyle: the surface of a card and of an agent's bubble, the page under an option, the green of a finished step
// and of the New line, the warm accent of an error, and the line around an option.
fn surface(): string = "light-dark(#f4f4f4, #212121)"
fn page(): string = "light-dark(#ffffff, #111111)"
fn positive(): string = "light-dark(#456d52, #8fbf99)"
fn attention(): string = "light-dark(#b84524, #fc855c)"
fn line(): string = "light-dark(rgb(60 60 67 / 0.18), rgb(84 84 88 / 0.6))"

// The face of an agent is a rounded square, the face of a person or a team a circle; its letter is bold at 56% of the
// size (LetterTile).
component Face
  props
    letter: string
    face: number
    size: number
    circle: bool
  view
    column width=size height=size border-radius=(circle ? size / 2 : size * 0.3) background-color=faceFill(face) color=faceInk(face) align-items="center" justify-content="center" flex-shrink=0 aria-hidden=true
      text letter font-size=(size * 0.56) font-weight=700

// The unread count of a chat: the green of the New line with the count in the colour of the page (UnreadBadge).
component CountBadge
  props
    count: number
  view
    text badgeText(count) font="-exact-caption2" font-weight=600 font-variant-numeric="tabular-nums" color="-exact-background" background-color="light-dark(#456d52, #8fbf99)" border-radius=9 min-width=18 height=18 padding="0px 6px" text-align="center" line-height="18px" flex-shrink=0 box-sizing="border-box" aria-label=`${count} unread` testId="unread-badge"

// One row of the list of chats (ChatRowLayout): the face, the name with the age of the newest message, and under it the
// line with the unread count. The line is the status of the chat in words, or its last message. A working chat shows
// the time of its newest step in place of the age, to the second, as its working line does.
component ChatRowView
  props
    chat: ChatRow
    now: number
    offset: number
    choose: action
  derive age = chat.step > 0 ? elapsed(now - chat.step) : compactAge(chat.at, now, offset)
  view
    button press=choose appearance="none" display="flex" flex-direction="row" align-items="center" gap=12 text-align="start" box-sizing="border-box" padding="8px 16px" min-height=52 width="100%" testId=`chat-${chat.id}`
      column position="relative" width=46 height=46 flex-shrink=0
        Face(letter=chat.letter, face=chat.face, size=46, circle=chat.circle)
        if chat.active
          view position="absolute" right=-2 bottom=-2 width=12 height=12 border-radius=6 background-color="light-dark(#456d52, #8fbf99)" border-width=2 border-style="solid" border-color="light-dark(#ffffff, #111111)" aria-hidden=true testId=`active-${chat.id}`
      column flex=1 min-width=0 gap=2
        row align-items="baseline" gap=8
          text chat.title font="-exact-body" font-weight=(chat.unread > 0 ? 600 : 400) line-clamp=1 flex=1 min-width=0 testId=`title-${chat.id}`
          text age font="-exact-footnote" font-variant-numeric="tabular-nums" color="-exact-secondary-label" flex-shrink=0 testId=`age-${chat.id}`
        row align-items="center" gap=8
          if chat.status == "needs_you"
            row align-items="center" gap=4 flex=1 min-width=0
              image "symbol:sf/circle.inset.filled" font="-exact-subheadline" color="light-dark(#b84524, #fc855c)" aria-hidden=true
              text chat.line font="-exact-subheadline" color="light-dark(#b84524, #fc855c)" line-clamp=1 testId=`line-${chat.id}`
          else
            text chat.line font="-exact-subheadline" color=(chat.status == "health" ? "light-dark(#b84524, #fc855c)" : "-exact-secondary-label") line-clamp=1 flex=1 min-width=0 testId=`line-${chat.id}`
          if chat.unread > 0
            CountBadge(count=chat.unread)

// One row of Needs attention (AttentionCard.row): the symbol of the rule, its label and detail, and the big number.
component AttentionRow
  props
    item: Attention
    first: bool
    choose: action
  view
    column width="100%"
      if not first
        view height=1 margin-left=44 background-color="light-dark(rgb(255 56 60 / 0.18), rgb(255 66 69 / 0.18))"
      button press=choose appearance="none" display="flex" flex-direction="row" align-items="center" gap=12 text-align="start" box-sizing="border-box" padding="10px 12px" width="100%" testId=`attention-${item.id}`
        image item.symbol width=20 height=20 color="-exact-system-red" aria-hidden=true
        column flex=1 min-width=0 gap=2
          text item.label font="-exact-body" font-weight=600 color="-exact-system-red" line-clamp=1
          text item.detail font="-exact-subheadline" color="-exact-secondary-label" line-clamp=1
        text item.value font="-exact-title2" font-weight=600 font-variant-numeric="tabular-nums" color="-exact-system-red" flex-shrink=0
        image "symbol:forward-chevron" color="-exact-system-red" opacity=0.6 aria-hidden=true

// The title of a group of a search, in the quiet colour of a title; the first group starts close under the field
// (HomeView.searchHeader).
component SearchHeader
  props
    title: string
    first: bool
  view
    text title role="heading" aria-level=2 font="-exact-subheadline" font-weight=600 color="-exact-secondary-label" line-clamp=1 padding=(first ? "8px 16px" : "16px 16px 8px") testId=`search-section-${title.toLowerCase()}`

// A card of a search, as a row of a to-do list: the symbol of a card that waits, its title, and the agent of the card
// (HomeView.searchRow).
component SearchCardRow
  props
    card: FoundCard
    choose: action
  view
    button press=choose appearance="none" display="flex" flex-direction="row" align-items="center" gap=12 text-align="start" box-sizing="border-box" padding="12px 16px" min-height=68 width="100%" testId=`search-card-${card.id}`
      image "symbol:sf/circle.inset.filled" font="-exact-title3" color=attention() width="1.5rem" flex-shrink=0 aria-hidden=true
      column flex=1 min-width=0 gap=4
        text card.title font="-exact-body" line-clamp=2
        text card.detail font="-exact-subheadline" color="-exact-secondary-label" line-clamp=1

// A message of a search (HomeView.messageRow): the name of its chat and its age, and under them its words around the
// first word of the search, two lines at most, where each word of the search has the weight and colour of a title. A
// message in the chat of the row above shows only its words and its age.
component SearchMessageRow
  props
    hit: FoundMessage
    now: number
    offset: number
    choose: action
  derive age = compactAge(hit.at, now, offset)
  view
    button press=choose appearance="none" display="flex" flex-direction="column" justify-content="center" gap=2 text-align="start" box-sizing="border-box" padding=(hit.continued ? "0px 16px 12px" : "12px 16px") min-height=(hit.continued ? 0 : 76) width="100%" testId=`search-message-${hit.id}`
      if hit.continued
        row align-items="baseline" gap=16
          text font="-exact-subheadline" color="-exact-secondary-label" line-clamp=2 flex=1 min-width=0
            for r, i in hit.runs key=i
              text r.text font-weight=(r.hit ? 600 : 400) color=(r.hit ? "-exact-label" : "-exact-secondary-label")
          text age font="-exact-footnote" font-variant-numeric="tabular-nums" color="-exact-secondary-label" flex-shrink=0
      else
        row align-items="baseline" gap=16
          text hit.name font="-exact-body" line-clamp=1 flex=1 min-width=0
          text age font="-exact-footnote" font-variant-numeric="tabular-nums" color="-exact-secondary-label" flex-shrink=0
        text font="-exact-subheadline" color="-exact-secondary-label" line-clamp=2
          for r, i in hit.runs key=i
            text r.text font-weight=(r.hit ? 600 : 400) color=(r.hit ? "-exact-label" : "-exact-secondary-label")

// The day above the first row of each day (DayPill): a small capsule in the fill of an agent's bubble, in the middle.
component DayPill
  props
    at: number
    now: number
    offset: number
  view
    row justify-content="center" padding="16px 0px 12px" testId="day"
      text formatDay(at, now, offset, "section") role="heading" aria-level=3 font="-exact-footnote" font-weight=600 padding="4px 12px" border-radius=12 background-color=surface()

// Slack's line above the first message that came since the person last read the chat: a thin green rule and New
// (NewMessagesLine).
component NewLine
  view
    row align-items="center" gap=8 padding="8px 0px" aria-label="New messages" testId="new-line"
      view flex=1 height=1 background-color=positive() aria-hidden=true
      text "New" font="-exact-caption1" font-weight=600 color=positive() aria-hidden=true

// The time under a row (MessageTimestamp), at the right edge under a message of the person.
component RowTime
  props
    id: string
    at: number
    now: number
    offset: number
    mine: bool
  view
    text messageTime(at, now, offset) font="-exact-caption2" font-variant-numeric="tabular-nums" color="-exact-tertiary-label" padding="0px 12px" align-self=(mine ? "flex-end" : "flex-start") testId=`time-${id}`

// Who wrote a message to another agent and to whom, or the agents that a message of the person went to
// (TranscriptMessageRow).
component SenderLine
  props
    sender: string
    mine: bool
  view
    text sender font="-exact-footnote" color="-exact-secondary-label" line-clamp=1 padding="0px 12px" align-self=(mine ? "flex-end" : "flex-start") testId="sender"

// The message that a message answers (MessageQuote): a bar, who wrote it, and two lines of it.
component Quote
  props
    author: string
    words: string
  view
    row gap=8 padding="4px 0px" testId="quote"
      view width=3 border-radius=2 align-self="stretch" background-color="-exact-secondary-label" aria-hidden=true
      column flex=1 min-width=0 gap=2
        if author != ""
          text author font="-exact-footnote" font-weight=600
        text words font="-exact-subheadline" color="-exact-secondary-label" line-clamp=2

// A message: on the right in the bubble of the person, on the left in the surface of a card (ChatBubbleBackground), with
// its time under it (MessageTimestamp). A team's message names who wrote it, a message between agents its sender, and
// an answer the message that it answers.
component Bubble
  props
    m: Message
    now: number
    offset: number
  view
    column gap=2 align-items=(m.mine ? "flex-end" : "flex-start") testId=`entry-${m.id}`
      if m.author != ""
        text m.author font="-exact-footnote" color="-exact-secondary-label" padding-left=12
      if m.sender != ""
        SenderLine(sender=m.sender, mine=m.mine)
      column gap=4 padding=12 border-radius=24 max-width="82%" box-sizing="border-box" background-color=(m.mine ? "light-dark(#e0c4a6, #63422e)" : "light-dark(#f4f4f4, #212121)") testId=`message-${m.id}`
        if m.quote != ""
          Quote(author=m.quoteAuthor, words=m.quote)
        text m.body markup="markdown" overflow-wrap="break-word"
      text messageTime(m.at, now, offset) font="-exact-caption2" font-variant-numeric="tabular-nums" color="-exact-tertiary-label" padding="0px 12px" testId=`time-${m.id}`

// One photo (PhotoTileRow.tile): a tile of 280 by 180 points alone, 236 by 180 beside others, with its caption under it.
// A hairline keeps the edge of a white picture on the white page. A photo that loads shows the coconut that waits, still
// under Reduce Motion (`still`), and one that did not load says so; a tap opens a photo that has loaded. The tile keeps
// its full strength while no tap opens it (`opacity=1`, which stops the host's dim of a disabled button), as Swift's does.
component PhotoTile
  props
    photo: Photo
    wide: bool
    still: bool
    open: action
  derive w = wide ? 280 : 236
  view
    button press=open disabled=(photo.state != "ready") opacity=1 appearance="none" display="flex" flex-direction="column" gap=4 padding=0 width=w flex-shrink=0 text-align="start" aria-label=(photo.caption != "" ? `Photo, ${photo.caption}` : "Photo") testId=`photo-${photo.key}`
      column width=w height=180 box-sizing="border-box" border-radius=12 border-width=1 border-style="solid" border-color=line() overflow="hidden" background-color=surface() align-items="center" justify-content="center"
        if photo.state == "ready"
          image photo.src width=w height=180 object-fit="cover" aria-hidden=true testId="photo-image"
        else if photo.state == "failed"
          column align-items="center" gap=6 padding=12
            image "symbol:photo" width=22 height=22 color="-exact-secondary-label" aria-hidden=true
            text "The photo did not load." font="-exact-footnote" color="-exact-secondary-label" text-align="center"
        else
          CoconutLoader(coconut=9.65, still=still, label="Loading the photo")
      if photo.caption != ""
        text photo.caption font="-exact-footnote" color="-exact-secondary-label" line-clamp=2 width=w

// A file an agent made: its name and the first lines of it.
component ArtifactCard
  props
    m: Message
  view
    column gap=6 padding=12 border-radius=16 background-color=surface() width="100%" box-sizing="border-box" testId=`artifact-${m.id}`
      row gap=8 align-items="center"
        image "symbol:document" aria-hidden=true
        text m.title font-weight=600 flex=1 min-width=0 line-clamp=1
      text m.body font="-exact-subheadline" color="-exact-secondary-label"

// A page of the Library that an agent made (DocumentCard): its symbol, its title and the words Library page.
component DocumentCard
  props
    m: Message
  view
    row gap=12 align-items="center" padding=12 border-radius=16 background-color=surface() width="100%" box-sizing="border-box" testId=`document-${m.id}`
      column width=36 height=36 border-radius=12 background-color=page() align-items="center" justify-content="center" flex-shrink=0
        image "symbol:document" width=18 height=18 color="-exact-secondary-label" aria-hidden=true
      column flex=1 min-width=0 gap=2
        text m.title font="-exact-subheadline" font-weight=600 line-clamp=2
        text "Library page" font="-exact-subheadline" color="-exact-secondary-label" line-clamp=1

// A background process of Hermes that ended (ProcessNoticeRow): a check or a cross, its name, how it ended with its run
// time, and an edge in the colour of the outcome. A tap shows the command; a failure shows its last output at once.
component ProcessRow
  props
    m: Message
  state open = false
  derive tint = m.failed ? "-exact-system-red" : positive()
  derive shows = m.detail != "" and (m.failed or open)
  action toggle
    open = not open
  view
    row border-radius=12 overflow="hidden" background-color="light-dark(rgb(244 244 244 / 0.6), rgb(33 33 33 / 0.6))" width="100%" box-sizing="border-box" testId=`process-${m.id}`
      view width=3 align-self="stretch" background-color=tint aria-hidden=true
      column flex=1 min-width=0 gap=8 padding="4px 12px"
        button press=toggle disabled=(m.failed or m.detail == "") appearance="none" display="flex" flex-direction="row" align-items="center" gap=8 min-height=44 padding=0 width="100%" text-align="start" aria-label=`Background task ${m.failed ? "failed" : "finished"}: ${m.title}` aria-expanded=shows testId=`process-toggle-${m.id}`
          image (m.failed ? "symbol:sf/xmark.circle.fill" : "symbol:select-fill") width=20 height=20 color=tint aria-hidden=true
          column flex=1 min-width=0 gap=1
            text m.title font="-exact-subheadline" font-weight=500 line-clamp=1
            text m.body font="-exact-caption1" font-variant-numeric="tabular-nums" color="-exact-secondary-label" line-clamp=1
          if not m.failed and m.detail != ""
            image (open ? "symbol:sf/chevron.down" : "symbol:forward-chevron") width=12 height=12 color="-exact-tertiary-label" aria-hidden=true
        if shows
          text m.detail font="-exact-caption1" font-family="monospace" padding=8 margin-bottom=4 border-radius=8 background-color=page() overflow-wrap="anywhere" testId=`process-detail-${m.id}`

// A notice of a team: its kind, its words, who posted it and when.
component NoticeCard
  props
    m: Message
    now: number
    offset: number
  view
    column gap=2 padding=12 border-radius=16 background-color=surface() testId=`notice-${m.id}`
      text m.title font="-exact-footnote" font-weight=600 color="light-dark(#b84524, #fc855c)"
      text m.body markup="markdown"
      text `${m.author} · ${messageTime(m.at, now, offset)}` font="-exact-caption2" font-variant-numeric="tabular-nums" color="-exact-secondary-label"

// A card of an agent (DecisionCard): the earlier choice of a follow-up, the title with its sources and the size of a
// pull request, and the X that dismisses it. While it waits, the context and the risk; then what the caller puts in it
// (its previews, its draft and its options); then a choice that waits for its Undo, why the last answer did not go, and
// once answered the receipt.
component CardView
  props
    card: Card
    dismiss: action
    undo: action
  slot
  derive closed = not card.pending and not card.refreshing
  derive markTint = card.sending or card.mark == "symbol:close" ? "-exact-secondary-label" : card.mark == "symbol:alert" ? attention() : positive()
  derive markLabel = card.sending ? "Sending choice" : card.mark == "symbol:close" ? "Dismissed" : card.mark == "symbol:alert" ? "Action failed" : "Choice recorded"
  view
    column gap=16 padding=16 border-radius=24 background-color=surface() width="100%" box-sizing="border-box" testId=`card-${card.ref}`
      if card.earlier != ""
        row gap=6 align-items="center" testId=`earlier-${card.ref}`
          image "symbol:reply" width=14 height=14 color="-exact-secondary-label" aria-hidden=true
          text card.earlier font="-exact-footnote" color="-exact-secondary-label"
      row align-items="flex-start" gap=8
        // DecisionIntroduction: the title, its sources and the size of a pull request, then while it waits the context
        // and the risk, all beside the X.
        column flex=1 min-width=0 gap=16
          column gap=8
            text card.title font="-exact-body" font-weight=600 role="heading" aria-level=3 testId=`card-title-${card.ref}`
            if card.sources.length > 0
              column gap=4
                for s in card.sources key=s
                  text s font="-exact-footnote" color="-exact-secondary-label"
            if card.diff != ""
              text card.diff font="-exact-footnote" font-variant-numeric="tabular-nums" color="-exact-secondary-label" testId=`card-diff-${card.ref}`
          if card.pending and card.context.length > 0
            column gap=8
              for p in card.context key=p
                text p font="-exact-subheadline" color="-exact-secondary-label"
          if card.pending and card.stale
            text "Assessment needs updating" font="-exact-subheadline" color="-exact-secondary-label"
          else if card.pending and card.reason != ""
            column gap=4 testId=`card-risk-${card.ref}`
              text card.risk font="-exact-subheadline" font-weight=500
              text card.reason font="-exact-subheadline" color="-exact-secondary-label"
        if card.dismissible
          button press=dismiss appearance="none" aria-label="Dismiss card" width=44 height=44 margin="-10px -10px 0px 0px" display="flex" align-items="center" justify-content="center" flex-shrink=0 testId=`dismiss-${card.ref}`
            image "symbol:close" width=16 height=16 color="-exact-secondary-label"
      if card.waiting
        UndoRow(label=card.chosenLabel, undo=undo)
      children
      if card.error != ""
        text card.error font="-exact-footnote" color=attention() testId=`card-error-${card.ref}`
      if card.refreshing
        text "Updating this card…" font="-exact-subheadline" color="-exact-secondary-label"
      else if card.sending or closed
        row gap=12 align-items="center" padding=12 min-height=44 box-sizing="border-box" border-radius=12 border-width=1 border-style="solid" border-color=line() background-color=page() testId=`receipt-${card.ref}`
          text card.receipt font="-exact-subheadline" color=(card.dim ? "-exact-secondary-label" : "-exact-label") flex=1 min-width=0
          if card.mark != ""
            image card.mark width=16 height=16 color=markTint aria-label=markLabel
        if closed and card.outcome != ""
          text card.outcome font="-exact-footnote" color=attention()
        if closed and card.revised
          text "A newer card replaced this one." font="-exact-footnote" color="-exact-secondary-label"

// One option of a card (DecisionChoiceContent): the label with Recommended, what it does and its risk, on the page's
// colour with a thin line around it. An option that approves waits for the previews of its card.
component ChoiceButton
  props
    option: Choice
    disabled: bool
    pick: action
  view
    button press=pick disabled=disabled appearance="none" display="flex" flex-direction="column" align-items="stretch" gap=5 padding=12 min-height=44 width="100%" box-sizing="border-box" text-align="start" border-radius=12 border-width=1 border-style="solid" border-color=line() background-color=page() opacity=(disabled ? 0.5 : 1) aria-label=(option.recommended ? `${option.label}, Recommended` : option.label) testId=`option-${option.id}`
      row align-items="baseline" gap=8 flex-wrap="wrap"
        text option.label font="-exact-body"
        if option.recommended
          text "Recommended" font="-exact-footnote" color="-exact-secondary-label"
      if option.explanation != ""
        text option.explanation font="-exact-subheadline" color="-exact-secondary-label"
      if option.reason != ""
        column gap=4
          text option.risk font="-exact-subheadline" font-weight=500
          text option.reason font="-exact-subheadline" color="-exact-secondary-label"

// The message of a draft card (MessageDraftContent): Via, From, To, Reply to and Subject, a rule, and the body.
component DraftBox
  props
    draft: Draft
  view
    column gap=12 padding=12 border-radius=12 background-color=page() width="100%" box-sizing="border-box" testId="draft"
      column gap=8
        DraftField(label="Via", value=draft.via)
        if draft.from != ""
          DraftField(label="From", value=draft.from)
        DraftField(label="To", value=draft.to)
        if draft.replyTo != ""
          DraftField(label="Reply to", value=draft.replyTo)
        if draft.subject != ""
          DraftField(label="Subject", value=draft.subject)
      view height=1 background-color=line() aria-hidden=true
      text draft.body font="-exact-body" white-space="pre-wrap" overflow-wrap="break-word" testId="draft-body"

component DraftField
  props
    label: string
    value: string
  view
    row gap=12 align-items="baseline"
      text label font="-exact-subheadline" color="-exact-secondary-label" width="3.7rem" flex-shrink=0
      text value font="-exact-subheadline" flex=1 min-width=0 overflow-wrap="anywhere"

// Send and Discard of a draft card (MessageDraftActions): Send fills the coconut brown, Discard is quiet.
component DraftButton
  props
    label: string
    primary: bool
    pick: action
  view
    button press=pick appearance="none" display="flex" align-items="center" justify-content="center" min-height=44 padding="0px 16px" border-radius=22 background-color=(primary ? "light-dark(#7a4e2d, #d4a574)" : "transparent") testId=`draft-${label}`
      text label font="-exact-body" font-weight=(primary ? 600 : 400) color=(primary ? "-exact-background" : "-exact-secondary-label")

// The choice that waits for its Undo (AnswerUndoRow): it shows as sent, and Undo takes it back before it reaches the Mac.
component UndoRow
  props
    label: string
    undo: action
  view
    row gap=12 align-items="center" testId="undo-row"
      row gap=6 align-items="center" flex=1 min-width=0
        image "symbol:select-fill" width=18 height=18 color=positive() aria-hidden=true
        text label font="-exact-subheadline" font-weight=600 line-clamp=2
      button press=undo buttonStyle="bordered" testId="undo-answer"
        text "Undo"

// What the agent does now, as BotStatusRow shows it under the newest message: the phase, then the time of its newest
// step to the second, the model and the messages that wait, and the command in monospace under them. While the agent
// writes, a small coconut juggles before the phase, except under Reduce Motion (`still`).
component WorkingLine
  props
    turn: Turn
    now: number
    still: bool
  view
    column padding="6px 14px 10px" gap=2 testId="working"
      row gap=6 align-items="center" flex-wrap="wrap"
        if turn.writing and not still
          CoconutLoader(coconut=5, still=false, label="")
        text turn.phase font="-exact-subheadline" color="-exact-secondary-label" testId="working-phase"
        text `· ${elapsed(now - turn.startedAt)} · ${turn.model}${turn.queued > 0 ? ` · ${turn.queued} queued` : ""}` font="-exact-subheadline" font-variant-numeric="tabular-nums" color="-exact-secondary-label" testId="working-meta"
      if turn.detail != ""
        text turn.detail font="-exact-caption1" font-family="monospace" color="-exact-secondary-label" line-clamp=1 testId="working-detail"

// A message that waits for the next turn (MessageQueue's QueueItemRow): its place, its first line, its files, and what
// happens to it now: Sending, Steering, or the … button of its menu, `queue-menu-<id>`, which the screen writes and
// which a long press on the row opens too. A row after the first has a line over it, from the text on.
component QueueRow
  props
    q: Queued
    first: bool
  view
    column
      if not first
        view height=1 margin-left=36 background-color=line() aria-hidden=true
      row align-items="center" gap=8 min-height=44 padding="0px 12px" contextPopover=(q.canChange ? `queue-menu-${q.id}` : "") aria-label=`Queued ${q.position}: ${q.preview}` testId=`queue-row-${q.position}`
        text `${q.position}` font="-exact-caption1" font-weight=500 font-variant-numeric="tabular-nums" color="-exact-secondary-label" min-width="1rem" flex-shrink=0 text-align="end" aria-hidden=true
        text q.preview font="-exact-subheadline" color=(q.state == "sending" ? "-exact-secondary-label" : "-exact-label") line-clamp=1 flex=1 min-width=0
        if q.attachments > 0
          row align-items="center" gap=2 flex-shrink=0 aria-label=(q.attachments == 1 ? "1 attachment" : `${q.attachments} attachments`)
            image "symbol:sf/paperclip" width=12 height=12 color="-exact-secondary-label" aria-hidden=true
            text `${q.attachments}` font="-exact-caption1" color="-exact-secondary-label" aria-hidden=true
        if q.state == "sending"
          text "Sending" font="-exact-caption1" color="-exact-tertiary-label" flex-shrink=0
        else if q.state == "steering"
          text "Steering" font="-exact-caption1" color="-exact-secondary-label" flex-shrink=0
        else if q.canChange or q.canSteer
          button appearance="none" popovertarget=`queue-menu-${q.id}` aria-label=`Actions of queued message ${q.position}` width=36 height=44 flex-shrink=0 display="flex" align-items="center" justify-content="center" testId=`queue-actions-${q.position}`
            image "symbol:ellipsis" width=16 height=16 color="-exact-secondary-label"
