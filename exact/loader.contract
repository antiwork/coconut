// The coconut that waits, as CoconutLoader draws it in the iPhone app (ios/Coconut/CoconutLoader.swift, the spec): the
// mark hops and tosses its three holes into a cascade, and once in a long wait a throw goes wide and a new coconut
// falls in from the top. Reduce Motion keeps the mark still while a wave crosses its holes. Each keyframes block below
// is a Track of the Swift file: a key at its fraction of the loop, its value in coconuts as a percentage of a hole (100%
// is one coconut), and the segment to the next key on cubic-bezier(1/3, y1, 2/3, y2), linear when y1 and y2 are 1/3
// and 2/3. A hole is three views, as in the CSS of the design: the across, the up and down, and the dot.

// `coconut` is the width of one coconut in points, 9.65 on a page and 5 in a line of text; the box is 4.2 by 4.56 of
// them, its hands at the bottom middle. `label` is what VoiceOver reads; an empty one leaves the wait to the text
// beside the loader. The holes take the secondary label colour, as `.foregroundStyle(.secondary)` gives them.
component CoconutLoader
  props
    coconut: number
    still: bool
    label: string
  derive dot = coconut / 2
  view
    view position="relative" width=(coconut * 4.2) height=(coconut * 4.56) flex-shrink=0 overflow="hidden" role="img" aria-label=label aria-hidden=(label == "")
      if still
        view position="absolute" left=(coconut * 0.855) top=(coconut * 1.135) width=coconut height=coconut border-radius=dot background-color="-exact-secondary-label" opacity=0.35 animation="wave 1s linear infinite"
        view position="absolute" left=(coconut * 2.345) top=(coconut * 1.135) width=coconut height=coconut border-radius=dot background-color="-exact-secondary-label" opacity=0.35 animation="wave 1s linear 0.2s infinite"
        view position="absolute" left=(coconut * 1.6) top=(coconut * 2.425) width=coconut height=coconut border-radius=dot background-color="-exact-secondary-label" opacity=0.35 animation="wave 1s linear 0.4s infinite"
      else
        // The left eye, the right eye and the mouth join the cascade two thirds, none and one third of a period in
        // (Juggle.phases); the loop starts 0.35 s in, so the mark hops at once. The toss lasts 2 s of its 4.2, then
        // the cascade under it shows.
        view position="absolute" left=(coconut * 1.6) top=(coconut * 3) width=coconut height=coconut animation="juggleX 1.68s linear -1.47s infinite, toss0X 4.2s linear -0.35s 0.47619"
          view width=coconut height=coconut animation="juggleY 1.68s linear -1.47s infinite, toss0Y 4.2s linear -0.35s 0.47619"
            view width=coconut height=coconut border-radius=dot background-color="-exact-secondary-label" animation="fumbleHide 30.24s step-end 19.81s infinite"
        view position="absolute" left=(coconut * 1.6) top=(coconut * 3) width=coconut height=coconut animation="juggleX 1.68s linear -0.35s infinite, toss1X 4.2s linear -0.35s 0.47619"
          view width=coconut height=coconut animation="juggleY 1.68s linear -0.35s infinite, toss1Y 4.2s linear -0.35s 0.47619"
            view width=coconut height=coconut border-radius=dot background-color="-exact-secondary-label"
        view position="absolute" left=(coconut * 1.6) top=(coconut * 3) width=coconut height=coconut animation="juggleX 1.68s linear -0.91s infinite, toss2X 4.2s linear -0.35s 0.47619"
          view width=coconut height=coconut animation="juggleY 1.68s linear -0.91s infinite, toss2Y 4.2s linear -0.35s 0.47619"
            view width=coconut height=coconut border-radius=dot background-color="-exact-secondary-label"
        // The throw that goes wide takes the place of the left eye for three periods, 20 s into the wait and then every
        // 30 s. It starts and ends where the left eye of the cascade is then.
        view position="absolute" left=(coconut * 1.6) top=(coconut * 3) width=coconut height=coconut animation="fumbleX 30.24s linear 19.81s infinite"
          view width=coconut height=coconut animation="fumbleY 30.24s linear 19.81s infinite"
            view width=coconut height=coconut border-radius=dot background-color="-exact-secondary-label" opacity=0 animation="fumbleShow 30.24s step-end 19.81s infinite"

// The cascade, a period of 1.68 s: across, from the hand of a hole, in coconuts (100% is one).
keyframes juggleX
  0% translate="25% 0%"
  40% translate="-160% 0%" animation-timing-function="cubic-bezier(0.3333, 0, 0.6667, 0.8858)"
  50% translate="-25% 0%"
  90% translate="160% 0%" animation-timing-function="cubic-bezier(0.3333, 0, 0.6667, 0.8858)"
  100% translate="25% 0%"
// Up and down, with the small dip of a catch. A negative y is up.
keyframes juggleY
  0% translate="0% 0%" animation-timing-function="cubic-bezier(0.3333, 0.6667, 0.6667, 1)"
  20% translate="0% -300%" animation-timing-function="cubic-bezier(0.3333, 0, 0.6667, 0.3333)"
  40% translate="0% 0%" animation-timing-function="cubic-bezier(0.3333, 0.4694, 0.6667, 1)"
  45.863% translate="0% 56.21%" animation-timing-function="cubic-bezier(0.3333, 0, 0.6667, 0.2641)"
  50% translate="0% 0%" animation-timing-function="cubic-bezier(0.3333, 0.6667, 0.6667, 1)"
  70% translate="0% -300%" animation-timing-function="cubic-bezier(0.3333, 0, 0.6667, 0.3333)"
  90% translate="0% 0%" animation-timing-function="cubic-bezier(0.3333, 0.4694, 0.6667, 1)"
  95.863% translate="0% 56.21%" animation-timing-function="cubic-bezier(0.3333, 0, 0.6667, 0.2641)"
  100% translate="0% 0%"
// The toss of the left eye, 4.2 s long: it leaves the mark and joins the cascade at 2 s.
keyframes toss0X
  0% translate="-74.5% 0%"
  14.079% translate="-74.5% 0%" animation-timing-function="cubic-bezier(0.3333, 0, 0.6667, 1)"
  15.635% translate="-72.21% 0%" animation-timing-function="cubic-bezier(0.3333, 0, 0.6667, 0.25)"
  16.413% translate="-74.5% 0%"
  29.333% translate="-160% 0%" animation-timing-function="cubic-bezier(0.3333, 0, 0.6667, 0.8858)"
  33.333% translate="-25% 0%"
  49.333% translate="160% 0%" animation-timing-function="cubic-bezier(0.3333, 0, 0.6667, 0.8858)"
  53.333% translate="25% 0%"
  69.333% translate="-160% 0%" animation-timing-function="cubic-bezier(0.3333, 0, 0.6667, 0.8442)"
  73.333% translate="-25% 0%"
  79.641% translate="74.5% 0%" animation-timing-function="cubic-bezier(0.3333, 0.75, 0.6667, 1)"
  80.752% translate="78.39% 0%" animation-timing-function="cubic-bezier(0.3333, 0, 0.6667, 1)"
  82.974% translate="74.5% 0%"
  100% translate="74.5% 0%"
