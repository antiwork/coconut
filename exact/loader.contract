  0% translate="0% -291.67%" animation-timing-function="cubic-bezier(0.3333, -0.1333, 0.6667, 0.2)"
  1.2963% translate="0% 0%" animation-timing-function="cubic-bezier(0.3333, 0.4694, 0.6667, 1)"
