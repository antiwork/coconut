  53.333% translate="0% 0%" animation-timing-function="cubic-bezier(0.3333, 0.6667, 0.6667, 1)"
  61.333% translate="0% -300%" animation-timing-function="cubic-bezier(0.3333, 0, 0.6667, 0.3333)"
  69.333% translate="0% 0%" animation-timing-function="cubic-bezier(0.3333, 0.5376, 0.6667, 1)"
  71.593% translate="0% 47.28%" animation-timing-function="cubic-bezier(0.3333, 0, 0.6667, 0.2744)"
