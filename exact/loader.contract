// The left eye of the cascade gives way to the one that goes wide, and comes back after it.
keyframes fumbleHide
  0% opacity=0
  16.6667% opacity=1
  100% opacity=1
keyframes fumbleShow
  0% opacity=1
  16.6667% opacity=0
  100% opacity=0
// Reduce Motion: a wave crosses the still holes in 0.6 s, then rests for 0.4 s.
keyframes wave
  0% opacity=0.35 animation-timing-function="cubic-bezier(0.61, 1, 0.88, 1)"
  20% opacity=1 animation-timing-function="cubic-bezier(0.12, 0, 0.39, 0)"
  40% opacity=0.35
  100% opacity=0.35
