  41.333% translate="0% -300%" animation-timing-function="cubic-bezier(0.3333, 0, 0.6667, 0.3333)"
  49.333% translate="0% 0%" animation-timing-function="cubic-bezier(0.3333, 0.4694, 0.6667, 1)"
