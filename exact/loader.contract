// The throw that goes wide, 5.04 s of 30.24: the hole flies out, and a new one falls in from the top.
keyframes fumbleX
  0% translate="52.08% 0%"
  1.2963% translate="160% 0%" animation-timing-function="cubic-bezier(0.3333, 0, 0.6667, 0.8858)"
  1.8518% translate="25% 0%"
  4.074% translate="-160% 0%" animation-timing-function="cubic-bezier(0.3333, 0, 0.6667, 0.8858)"
  4.6297% translate="-25% 0%"
