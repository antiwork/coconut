// Coconut on Exact. Home: the search field, Needs attention, one flat list of chats (the unread ones first, then the
// newest), and a message box that is always open, with a project picker that names the project the message goes to. In
// place of the list, a search shows the chats, the cards that wait and the messages that have its words, and the box
// leaves while it is open. A chat: its messages with Markdown under the day they came, the New line, photos and their
// viewer, cards with their previews, drafts and options, the working line, and the composer. Paired with a Mac, app.ts
// answers it from the Mac's Coconut through the relay, and a round is one connection: `prepare` gets a socket ticket,
// `sock` is the socket, `deliver` lets the answers that wait for it go on, and `live` is the handshake and the sync.
// Before a pairing the app shows a pairing code; "Look around with demo data" answers from the preview fixture of the
// Swift app (ios/Coconut/Fixtures). app.forma has the palette of Theme.swift. The rows write its values out, because
// the SDK snapshot that Exact Build compiles with (2026-11-14) refuses a token name as a colour; name the tokens again
// once its catalog is newer.
// Colours, fonts, sizes and the safe area are the platform's unless a row says otherwise.
use Ack, Chat, DeliveryState, Draft, Edited, Found, Home, Live, MacFound, Made, Media, PairCode, PairState, Photo, Saved, Sock, Suggestion, Time, Viewport from "./shapes.contract"
use ArtifactCard, AttentionRow, Bubble, CardView, ChatRowView, ChoiceButton, DayPill, DocumentCard, DraftBox, DraftButton, DraftEdit, Face, NewLine, NoticeCard, PhotoTile, ProcessRow, RowTime, SearchCardRow, SearchHeader, SearchMessageRow, SenderLine, QueueRow, WorkingLine from "./parts.contract"
use EmptyState from "exact:content"

routes nav
  home "/"
    chat "/chat/:id"
    new "/new"
    draft "/draft"
    photo "/photo"

component Coconut
  // The project the box of Home sends to. Empty is the project of the newest chat; app.ts names it in `home.target`.
  state target = ""
  state draft = ""
  state chatDraft = ""
  // The queued message that the queue edits in place of its row, and the words of that edit (MessageQueue).
  state editingQueued = ""
  state queueDraft = ""
  state composing = false
  // The words of the search field of Home, and whether the field has the keyboard.
  state query = ""
  state searchFocus = false
  // The files of the next message, as the pickers gave them, and which of them came from the photo library.
  state attached: Picked[] = []
  state photos: string[] = []
  state projectName = ""
  // The draft card that the sheet of Edit draft changes (MessageDraftEditor), its revision when the sheet opened, the
  // fields of its message, which of From and Reply to the draft has, and why the last Save did not go.
  state editingRef = ""
  state editRevision = 0
  state editVia = ""
  state editFrom = ""
  state editTo = ""
  state editReplyTo = ""
  state editSubject = ""
  state editBody = ""
  state editHasFrom = false
  state editHasReplyTo = false
  state editError = ""
  // The time since launch, written once a second: the age of a chat and the seconds of a turn read it.
  state since = 0
  // The demo answers from the fixture. A round is one connection to the Mac; `refresh` asks for its next read.
  state demo = false
  state round = 0
  state refresh = 0
  state codeRound = 0
  state poll = 0
  // The pairings that the screens have read from the Keychain: a pairing or an unpairing in `live` moves it.
  state pairsRead = 0
  // Each opening of a chat: the New line keeps the read mark that the chat opened with (UnreadMark).
  state opened = 0
  // The next photo of the open chat to keep from the Mac, and the photos that the viewer shows, with the one in view.
  state mediaRound = 0
  state viewed: Photo[] = []
  state viewAt = 0
  resource time = exactTime() as shape Time
  // The update that runs, and whether a newer one waits to apply.
  resource delivery = exactDelivery() as shape DeliveryState
  // Reduce Motion, which keeps the coconut that waits still.
  resource viewport = exactViewport() as shape Viewport
  resource saved = loadSaved(pairsRead) as shape Saved else empty()
  resource code = pairCode(codeRound) when mode == "pair" as shape PairCode else empty()
  resource pairing = pairWait(code.id, poll) when mode == "pair" and code.id != "" as shape PairState else empty()
  resource ticket = prepare(connectKey) when connectKey != "" as shape string else empty()
  resource sock = socket(ticket) when ticket != "" and ticket == connectKey as shape Sock else empty()
  resource pump = deliver(sock.n) when sock.n > 0 as shape number else empty()
  resource live = sync(connectKey, sock.status == "open" and sock.key == connectKey, refresh) when connectKey != "" as shape Live else empty()
  resource home = loadHome(time.epochAtZero, target, mode == "live", live.version) when mode != "pair" as shape Home else empty()
  // The search of Home: the chats, the cards and the messages of the phone at once (`found`), then the messages with
  // those of the Mac (`more`), 200 ms after the last key. Each answers with the words it searched (`q`).
  resource found = searchPhone(query, mode == "live", live.version) with time.epochAtZero when searching and mode != "pair" as shape Found else empty()
  resource more = searchMac(query, mode == "live") with time.epochAtZero when searching and mode == "live" as shape MacFound else empty()
  // A chat reads its rows again for each photo that the phone kept (`media.n`), and its days in the zone of the person.
  resource chat = loadChat(time.epochAtZero, openId, mode == "live", live.version, time.utcOffset, opened, media.n) when openId != "" and mode != "pair" as shape Chat else empty()
  // The photos of the open chat come from the Mac one in each answer (`mediaRound`, see `fetchingMedia`).
  resource media = loadMedia(openId, mode == "live", mediaRound) when openId != "" and mode == "live" as shape Media else empty()
  // The slash menu over the message box: `/model` and `/effort`, as in the Swift app, where they change the model and
  // the effort of every chat (ComposerSlash). Options have no other place in the screens. A resource whose `when` turns
  // false keeps the rows it had, so the menu and Send read them only while the draft starts with a slash (`slashing`),
  // and an empty draft asks once more, which empties them: a chosen model or effort empties the box (#575).
  resource slash = suggest(openId, chatDraft, mode == "live", live.version) when openId != "" and mode != "pair" and (slashing or chatDraft == "") as shape Suggestion[] else empty()
  mutation started as shape Made queue refreshes home, found then afterStart
  mutation created as shape Made refreshes home, found then afterCreate
  // A write to the Mac is a queue: a newer send of a mutation that takes the newest reply lets the answer in flight go,
  // and an answer let go stops wherever it is on the connection that every answer shares (app.ts, `write`).
  mutation read as shape Ack queue refreshes home, found
  // A write needs no read of its own after it: the Mac's change ends the read that waits for one (see `following`).
  mutation queued as shape Made refreshes chat, home, found then afterQueued
  mutation sent as shape Ack queue refreshes chat, home, found
  mutation stopped as shape Ack queue refreshes chat, home, found
  // A change of the queue of the open chat shows at once (`overlay` in app.ts), and the changes go to the Mac in order.
  mutation queueChanged as shape Ack queue refreshes chat, home, found
  // A choice on a card shows at once with Undo (`chosen`), and `answered` sends it once the Undo has passed. Both are
  // queues, so a choice on a second card waits for the first instead of letting it go.
  mutation chosen as shape Made queue refreshes chat, home, found then afterChoose
  mutation answered as shape Ack queue refreshes chat, home, found
  mutation undone as shape Ack refreshes chat, home, found
  mutation dismissed as shape Ack queue refreshes chat, home
  // Save of Edit draft: the sheet closes once the Mac keeps the new message, and says why when it does not.
  mutation draftSaved as shape Edited refreshes chat, home, found then afterDraftSave
  // The menu asks again once the Mac took a model or an effort, so a `/model` typed before its answer moves the mark.
  mutation modelSet as shape Ack queue refreshes chat, slash
  mutation effortSet as shape Ack queue refreshes chat, slash
  derive now = time.epochAtZero + since
  derive still = viewport.prefersReducedMotion
  derive mode = demo ? "demo" : saved.paired ? "live" : "pair"
  // What the round connects for: the Mac's state, or the pairing of a setup that came into the box of the code. An
  // update that applies brings a new data module, which has no socket or handshake of the old one, so the number of the
  // update is part of the round.
  derive connectKey = mode == "live" ? `token:${delivery.seq}:${round}` : mode == "pair" and pairing.status == "ready" ? `pair:${pairing.id}` : ""
  derive pairText = code.code == "" ? "" : `pair ${code.code}`
  derive pairStatus = code.error != "" ? code.error : pairing.status == "ready" ? (live.error != "" ? live.error : `Pairing with ${pairing.macName}…`) : pairing.status == "expired" ? "This code expired." : pairing.status == "error" ? pairing.error : code.code == "" ? "" : "Waiting for your Mac…"
  derive pairFailed = code.error != "" or pairing.status == "expired" or pairing.status == "error" or (pairing.status == "ready" and live.error != "")
  derive openId = match stack(nav).filter(e => e.name == "chat").at(-1) { case some(e) => e.params.id, case none => "" }
  derive startedId = match started { case some(s) => s.id, case none => "" }
  derive createdId = match created { case some(c) => c.id, case none => "" }
  derive queuedId = match queued { case some(q) => q.id, case none => "" }
  derive chosenId = match chosen { case some(c) => c.id, case none => "" }
  derive draftSavedOk = match draftSaved { case some(e) => e.ok, case none => false }
  derive draftSaveError = match draftSaved { case some(e) => e.error, case none => "" }
  derive canSaveDraft = editTo.trim() != "" and editBody.trim() != "" and not pending(draftSaved)
  derive attentionTotal = sum(home.attention.map(a => a.count))
  derive hasText = draft.trim() != ""
  derive chatHasText = chatDraft.trim() != ""
  // The field has words, so the list shows what the search finds. A resource whose `when` turns false keeps its
  // answer, so the rows read the search only while the field has words, and they take the messages of the Mac once
  // those answer these words. An empty search says so once each list answered its words.
  derive searching = query.trim() != ""
  derive hits = more.q == query ? more.messages : found.messages
  derive searched = found.q == query and (mode != "live" or more.q == query)
  derive searchEmpty = searched and found.chats.length == 0 and found.cards.length == 0 and hits.length == 0
  // The box under the list leaves while the search is open, so the keyboard has one field (TabMessageBox).
  derive hideBar = searching or searchFocus
  derive canSend = chatHasText or attached.length > 0
  derive slashing = chatDraft.slice(0, 1) == "/"
  derive sending = pending(queued) or pending(sent)
  // ComposerExpansion.isOpen: a draft of more than one line, or an attachment, or the field with focus on a phone.
  derive expanded = chat.toolbar and (composing or chatDraft.length > 80 or chatDraft.includes("\n") or attached.length > 0)

  task clock mount
    every(1000, tick)
  action tick
    since = performanceNow()

  // The Mac's state follows the Mac. A read of updates waits up to 20 seconds on the Mac for a change (app.ts, `sync`),
  // and the next starts as it ends. A round whose socket closed, whose last read failed or whose ticket did not come
  // gives way to a new round after 15 seconds. No read is asked again while it runs: that lets it go with its
  // timeout, so a socket that died while the phone slept kept a read running for good. An update applies only when no
  // request runs, so no read starts while one waits.
  task following when mode == "live" and sock.status == "open" and sock.key == connectKey and live.error == "" and not pending(live) and not delivery.staged
    every(100, follow)
  action follow
    refresh = refresh + 1
  task retrying when mode == "live" and not pending(live) and not delivery.staged and (sock.status == "closed" or live.error != "" or (connectKey != "" and ticket == "" and not pending(ticket)))
    every(15000, reconnect)
  // A round whose session read the Mac and then ended gives way after 3 seconds (`live.quick`): a write waits for the
  // next round, and the relay takes 60 connections a minute.
  task retryingSoon when mode == "live" and live.quick and not pending(live) and not delivery.staged and (sock.status == "closed" or live.error != "")
    after(3000, reconnect)
  action reconnect
    round = round + 1

  // The box answers a long poll within 25 seconds; a poll that found nothing asks again.
  task polling when mode == "pair" and pairing.status == "waiting" and not pending(pairing)
    every(500, pollAgain)
  action pollAgain
    poll = poll + 1

  task pairedChanged when live.pairs != pairsRead
    after(1, readPairing)
  action readPairing
    pairsRead = live.pairs

  // The open chat asks the Mac for its next photo once the last answer is in, while it misses some and the socket is
  // open. A photo that did not load counts no more, and an update waits for no photo.
  task fetchingMedia when mode == "live" and openId != "" and chat.missing > 0 and sock.status == "open" and not pending(media) and not delivery.staged
    every(500, nextMedia)
  action nextMedia
    mediaRound = mediaRound + 1

  action copyCode
    copyText(pairText)
  action newCode
    codeRound = codeRound + 1
  action useDemo
    demo = true

  action back
    nav = back(nav)
  action openChat(id: string)
    nav = push(nav, path("chat", id))
    send read = markRead(id, opened + 1)
    opened = opened + 1
  action openNew
    projectName = ""
    nav = push(nav, "/new")
  // The search field of Home.
  action search(v: string)
    query = v
  action focusSearch
    searchFocus = true
  action blurSearch
    searchFocus = false
  // The box of Home: the project it sends to, the words, and Send, which starts a chat with that project.
  action pickProject(id: string)
    target = id
  action editDraft(v: string)
    draft = v
  action sendHome
    if hasText and not pending(started)
      send started = startChat(home.target.id, draft.trim(), performanceNow())
  // A Send never opens the chat that it makes, as in the Swift app (NewChatBar): the chat is the newest row of the list,
  // and the box keeps the keyboard, so the person can queue up many chats in a row.
  action afterStart
    if startedId != ""
      draft = ""

  // A new project: a name in a sheet. The box of Home then sends to it.
  action editName(v: string)
    projectName = v
  action saveProject
    if projectName.trim() != "" and not pending(created)
      send created = createProject(projectName.trim())
  action afterCreate
    if createdId != ""
      target = createdId
      nav = back(nav)

  // The composer of a chat.
  action editChat(v: string)
    chatDraft = v
  action focusChat
    composing = true
  action blurChat
    composing = false
  // Send runs the first row of the slash menu when it shows, as Return does in the Swift app. A message shows at once
  // (`queued`), and its files and words then go to the Mac (`sent`), which can take seconds for a photo. The rows that a
  // draft without a slash keeps are no menu: Send sends the words.
  action sendChat
    match (slashing ? slash.at(0) : none)
      case some(s)
        pickSlash(s.kind, s.value)
      case none
        if canSend and not sending
          send queued = queueMessage(chat.id, chatDraft.trim(), attached, photos, performanceNow())
          chatDraft = ""
          attached = []
          photos = []
        focus("chat-input")
  action afterQueued
    if queuedId != ""
      send sent = sendMessage(queuedId)
  action stopChat
    send stopped = stopTurn(chat.id)
  // The menu of a queued message (MessageQueue): Send now, Send to a new agent, Edit, Move up, Move down and Remove. A
  // move names the order that the person saw. Edit opens the words in place of the row; Save sends changed words.
  action steerRow(id: string)
    send queueChanged = steerQueued(chat.id, id)
  action newAgentRow(id: string)
    send queueChanged = sendQueuedToNewAgent(chat.id, id, performanceNow())
  action editRow(id: string, text: string)
    editingQueued = id
    queueDraft = text
  action typeRow(v: string)
    queueDraft = v
  action cancelRow
    editingQueued = ""
  action saveRow(id: string, old: string)
    if queueDraft.trim() != "" and queueDraft.trim() != old
      send queueChanged = editQueued(chat.id, id, queueDraft)
    editingQueued = ""
  action moveRow(id: string, offset: number)
    send queueChanged = moveQueued(chat.id, id, offset, chat.queue.filter(q => q.canChange).map(q => q.id))
  action removeRow(id: string)
    send queueChanged = removeQueued(chat.id, id)
  // A card: a choice, its Undo, and the X that dismisses the card without an answer. The choice and the X name the
  // revision of the card as it shows, so the Mac refuses them for a card that the agent changed meanwhile.
  action pickOption(ref: string, option: string, revision: number)
    send chosen = chooseOption(chat.id, ref, option, revision)
  action afterChoose
    if chosenId != ""
      send answered = answerCard(chat.id, chosenId)
  action takeBack(ref: string)
    send undone = undoAnswer(ref)
  action closeCard(ref: string, revision: number)
    send dismissed = dismissCard(chat.id, ref, revision)
  // Edit of a draft card (MessageDraftEditor): its message in a sheet, where Save keeps the change on the Mac. The card
  // keeps Send and Discard, and the message goes only with Send.
  action openDraft(ref: string, d: Draft, revision: number)
    editingRef = ref
    editRevision = revision
    editVia = d.via
    editFrom = d.from
    editTo = d.to
    editReplyTo = d.replyTo
    editSubject = d.subject
    editBody = d.body
    editHasFrom = d.from != ""
    editHasReplyTo = d.replyTo != ""
    editError = ""
    nav = push(nav, "/draft")
  action editFromField(v: string)
    editFrom = v
  action editToField(v: string)
    editTo = v
  action editReplyToField(v: string)
    editReplyTo = v
  action editSubjectField(v: string)
    editSubject = v
  action editBodyField(v: string)
    editBody = v
  action saveDraft
    if canSaveDraft
      editError = ""
      send draftSaved = saveCardDraft(openId, editingRef, editRevision, editFrom, editTo, editReplyTo, editSubject, editBody)
  action afterDraftSave
    if draftSavedOk
      nav = back(nav)
    else
      editError = draftSaveError != "" ? draftSaveError : "Could not save the draft. Try again."
  // The photos of a row or of a card, full screen, from the one that was tapped (PhotoViewer).
  action openPhotos(list: Photo[], at: number)
    viewed = list
    viewAt = at
    nav = push(nav, "/photo")
  action showPhoto(at: number)
    viewAt = at
  // A row of the slash menu: a command fills the box with itself and keeps the menu open for its choices; a model or
  // an effort is chosen, and the box empties.
  action pickSlash(kind: string, value: string)
    if kind == "complete"
      chatDraft = value
    if kind == "model"
      chatDraft = ""
      send modelSet = setModel(chat.id, value)
    if kind == "effort"
      chatDraft = ""
      send effortSet = setEffort(chat.id, value)
    focus("chat-input")
  action pickFile
    showPicker("attach-file")
  action pickPhoto
    showPicker("attach-photo")
  action pickedFiles(files: Picked[])
    attached = attached.concat(files)
  // A photo of the library goes at the size a screen shows (app.ts, as FileFit), so the app keeps where it came from.
  action pickedPhotos(files: Picked[])
    attached = attached.concat(files)
    photos = photos.concat(files.map(f => f.path))
  action detach(path: string)
    attached = attached.filter(f => f.path != path)
    photos = photos.filter(p => p != path)

  view
    main navigationKey=`${top(nav).id}` navigationBack="back" interactive-widget="resizes-content" testId="app" width="100%" height="100%" accent-color="light-dark(#7a4e2d, #d4a574)"
      if mode == "pair"
        column position="absolute" inset=0 display="flex" flex-direction="column" justify-content="center" gap=20 padding="24px 28px" background-color="light-dark(#ffffff, #111111)" testId="pair"
          text "Pair with your Mac" role="heading" aria-level=1 font="-exact-title2" font-weight=700
          text "Send this to Coconut on your Mac." font="-exact-body" color="-exact-secondary-label"
          if pairText != ""
            button appearance="none" press=copyCode aria-label=`Copy ${pairText}` display="flex" flex-direction="row" align-items="center" gap=10 padding="14px 16px" border-radius=14 background-color="light-dark(#f4f4f4, #212121)" testId="pair-code"
              text pairText font="-exact-body" font-weight=600 flex=1 min-width=0 testId="pair-text"
              image "symbol:copy" width=18 height=18 color="light-dark(#7a4e2d, #d4a574)" aria-hidden=true
          text pairStatus font="-exact-footnote" color="-exact-secondary-label" testId="pair-status"
          if pairFailed
            button press=newCode buttonStyle="bordered-prominent" testId="pair-new"
              text "New code"
          button appearance="none" press=useDemo padding="8px 0px" testId="pair-demo"
            text "Look around with demo data" font="-exact-subheadline" color="light-dark(#7a4e2d, #d4a574)"
      else
        for e in stack(nav) key=e.id
          if e.name == "home"
            column navigationKey=`${e.id}` navigationScroll="home-scroll" position="absolute" inset=0 display="flex" flex-direction="column" background-color="light-dark(#ffffff, #111111)"
              // The list is titled Agents, as the Agents tab of the Swift app is. Under the title, the search field (iOS:
              // UIKit's search controller) finds as the person types.
              header display="flex" flex-wrap="wrap" align-items="center" gap=8 padding="8px 16px"
                text "Agents" role="heading" aria-level=1 flex=1 testId="home-title"
                input type="search" value=query input=search focus=focusSearch blur=blurSearch placeholder="Search" aria-label="Search" width="100%" testId="search"
              if home.banner != ""
                text home.banner font="-exact-footnote" color="-exact-secondary-label" padding="0px 16px 6px" testId="home-banner"
              // Nothing has the words: no chat, no card, and no message of the phone or the Mac (HomeView.searchIsEmpty).
              if searching and searchEmpty
                EmptyState(symbol="symbol:search", title=`No Results for “${query.trim()}”`, message="Check the spelling or try a new search.")
              else
                scroll id="home-scroll" flex=1 min-height=0 keyboardDismissMode="on-drag" testId="home-scroll"
                  // In place of the list, the search (HomeView.searchRows): the chats, the cards that wait and the messages,
                  // each group under its title, and a group without hits does not show. A row opens its chat.
                  if searching
                    column padding="8px 0px 24px" testId="search-results"
                      if found.chats.length > 0
                        SearchHeader(title="Chats", first=true)
                        for c in found.chats key=c.id
                          ChatRowView(chat=c, now=now, offset=time.utcOffset, choose=openChat(c.id))
                      if found.cards.length > 0
                        SearchHeader(title="Cards", first=(found.chats.length == 0))
                        for k in found.cards key=k.id
                          SearchCardRow(card=k, choose=openChat(k.chat))
                      if hits.length > 0
                        SearchHeader(title="Messages", first=(found.chats.length == 0 and found.cards.length == 0))
                        for h in hits key=h.id
                          SearchMessageRow(hit=h, now=now, offset=time.utcOffset, choose=openChat(h.chat))
                  else
                    if home.attention.length > 0
                      column gap=8 padding="4px 16px 12px" testId="attention-card"
                        row align-items="center" gap=8 testId="attention-header"
                          text "Needs attention" font="-exact-subheadline" font-weight=600 color="-exact-system-red"
                          text `${attentionTotal}` font="-exact-caption1" font-weight=600 font-variant-numeric="tabular-nums" color="#ffffff" background-color="-exact-system-red" border-radius=9 min-width=18 height=18 padding="0px 6px" text-align="center" line-height="18px" box-sizing="border-box" testId="attention-count"
                        column border-radius=12 background-color="light-dark(rgb(255 56 60 / 0.08), rgb(255 66 69 / 0.08))" border-width=1 border-style="solid" border-color="light-dark(rgb(255 56 60 / 0.22), rgb(255 66 69 / 0.22))" overflow="hidden"
                          for a, i in home.attention key=a.id
                            AttentionRow(item=a, first=(i == 0), choose=openChat(a.chat))
                    // One list, with no tabs: the person found that nobody taps them (2026-11-24). The unread chats come
                    // first (app.ts, loadHome), and archived chats sit among the others by their newest message.
                    for c in home.chats key=c.id
                      ChatRowView(chat=c, now=now, offset=time.utcOffset, choose=openChat(c.id))
              column flex-shrink=0 padding="6px 12px 8px" display=(hideBar ? "none" : "flex") testId="home-bar"
                column border-radius=24 background-color="light-dark(#f4f4f4, #212121)" testId="home-box"
                  textarea id="home-input" value=draft input=editDraft rows=1 field-sizing="content" max-height=140 placeholder=`Message ${home.target.name}` aria-label="Message" border="none" background-color="transparent" min-width=0 padding="12px 16px 4px" testId="home-input"
                  row align-items="center" gap=4 height=44 padding="0px 6px 6px 6px"
                    button appearance="none" popovertarget="project-menu" retainFocus=true aria-label=`Project, ${home.target.name}` display="flex" flex-direction="row" align-items="center" gap=6 padding="4px 8px" min-width=0 testId="project-picker"
                      Face(letter=home.target.letter, face=home.target.face, size=20, circle=false)
                      text home.target.name font="-exact-subheadline" font-weight=600 color="-exact-secondary-label" line-clamp=1 testId="project-name"
                      image "symbol:chooser" font="-exact-caption2" color="-exact-secondary-label" aria-hidden=true
                    view flex=1
                    button appearance="none" press=sendHome disabled=(not hasText or pending(started)) retainFocus=true aria-label="Send" width=32 height=32 border-radius=16 background-color="light-dark(#7a4e2d, #d4a574)" opacity=(hasText ? 1 : 0.35) display="flex" align-items="center" justify-content="center" testId="home-send"
                      image "symbol:send" width=16 height=16 color="-exact-background"
          if e.name == "chat"
            column navigationKey=`${e.id}` navigationScroll="transcript" position="absolute" inset=0 display="flex" flex-direction="column" background-color="light-dark(#ffffff, #111111)"
              header display="flex" align-items="center" padding="8px 16px"
                text chat.title role="heading" aria-level=2 line-clamp=1 flex=1 testId="chat-title"
              list id="transcript" appearance="none" virtualized=true scroll-start="end" scrollFollowEnd=true keyboardDismissMode="interactive" flex=1 min-height=0 testId="transcript"
                for m in chat.messages key=m.id
                  column padding="3px 12px"
                    if m.startsDay
                      DayPill(at=m.at, now=now, offset=time.utcOffset)
                    if m.newLine
                      NewLine()
                    if m.kind == "text"
                      Bubble(m=m, now=now, offset=time.utcOffset)
                    else if m.kind == "photos"
                      // One photo stands on its side of the chat; more scroll sideways (PhotoTileRow).
                      column gap=2 align-items=(m.mine ? "flex-end" : "flex-start") testId=`entry-${m.id}`
                        if m.sender != ""
                          SenderLine(sender=m.sender, mine=m.mine)
                        if m.photos.length == 1
                          for p in m.photos key=p.key
                            PhotoTile(photo=p, wide=true, still=still, open=openPhotos(m.photos, 0))
                        else
                          scroll width="100%" overflow-x="auto" overflow-y="hidden" scrollbar-width="none" testId=`photos-${m.id}`
                            row gap=8
                              for p, i in m.photos key=p.key
                                PhotoTile(photo=p, wide=false, still=still, open=openPhotos(m.photos, i))
                        RowTime(id=m.id, at=m.at, now=now, offset=time.utcOffset, mine=m.mine)
                    else if m.kind == "activity"
                      text m.body font="-exact-footnote" color="-exact-secondary-label" padding="2px 12px" testId=`activity-${m.id}`
                    else if m.kind == "notice"
                      NoticeCard(m=m, now=now, offset=time.utcOffset)
                    else if m.kind == "artifact" or m.kind == "document" or m.kind == "process"
                      column gap=2 testId=`entry-${m.id}`
                        if m.sender != ""
                          SenderLine(sender=m.sender, mine=m.mine)
                        if m.kind == "artifact"
                          ArtifactCard(m=m)
                        else if m.kind == "document"
                          DocumentCard(m=m)
                        else
                          ProcessRow(m=m)
                        RowTime(id=m.id, at=m.at, now=now, offset=time.utcOffset, mine=m.mine)
                    else if m.kind == "decision"
                      // A card: its previews, its draft, then Send and Discard of a draft or the options of the rest.
                      // The options show while the card waits and no choice is held for it.
                      column gap=2 testId=`entry-${m.id}`
                        if m.sender != ""
                          SenderLine(sender=m.sender, mine=m.mine)
                        for c in m.card key=c.ref
                          CardView(card=c, dismiss=closeCard(c.ref, c.revision), undo=takeBack(c.ref))
                            if c.previews.length == 1
                              for p in c.previews key=p.key
                                PhotoTile(photo=p, wide=true, still=still, open=openPhotos(c.previews, 0))
                            else if c.previews.length > 1
                              scroll width="100%" overflow-x="auto" overflow-y="hidden" scrollbar-width="none" testId=`previews-${c.ref}`
                                row gap=8
                                  for p, i in c.previews key=p.key
                                    PhotoTile(photo=p, wide=false, still=still, open=openPhotos(c.previews, i))
                            for d in c.drafts key=d.to
                              DraftBox(draft=d)
                            if c.pending and c.chosen == ""
                              if c.drafts.length > 0
                                row gap=8 align-items="center" flex-wrap="wrap"
                                  // Send, Edit and Discard (MessageDraftActions): Edit opens the message in a sheet.
                                  for o in c.options.slice(0, 1) key=o.id
                                    DraftButton(label=o.label, primary=true, pick=pickOption(c.ref, o.id, c.revision))
                                  for d in c.drafts key=d.to
                                    DraftEdit(edit=openDraft(c.ref, d, c.revision))
                                  for o in c.options.slice(1) key=o.id
                                    DraftButton(label=o.label, primary=false, pick=pickOption(c.ref, o.id, c.revision))
                              else
                                column gap=8
                                  for o in c.options key=o.id
                                    ChoiceButton(option=o, disabled=(o.approve and not c.previewsReady), pick=pickOption(c.ref, o.id, c.revision))
                        RowTime(id=m.id, at=m.at, now=now, offset=time.utcOffset, mine=false)
                    else
                      WorkingLine(turn=chat.turn, now=now, still=still)
              column flex-shrink=0 padding="6px 12px 8px" testId="composer-bar"
                // The queue (MessageQueue) over the box: the messages that wait for the next turn, oldest first. Each
                // row opens its menu (`queue-menu-<id>`) from its … button or a long press, and Edit puts the words of
                // its message in place of the row. Past five rows the queue scrolls.
                if chat.queue.length > 0
                  column margin-bottom=8 border-radius=16 background-color="light-dark(#f4f4f4, #212121)" overflow="hidden" padding-bottom=4 testId="message-queue"
                    row align-items="center" gap=4 padding="8px 12px 4px" testId="queue-count"
                      image "symbol:sf/text.line.first.and.arrowtriangle.forward" width=12 height=12 color="-exact-secondary-label" aria-hidden=true
                      text `${chat.queue.length} queued` font="-exact-caption1" font-weight=500 color="-exact-secondary-label"
                      text "· next turn" font="-exact-caption1" font-weight=500 color="-exact-tertiary-label"
                    column max-height=242 overflow-y="auto"
                      for q in chat.queue key=q.id
                        if editingQueued == q.id
                          column testId="queue-editor"
                            if q.position > 1
                              view height=1 margin-left=36 background-color="light-dark(rgb(60 60 67 / 0.18), rgb(84 84 88 / 0.6))" aria-hidden=true
                            row align-items="center" gap=8 min-height=44 padding="6px 12px"
                              text `${q.position}` font="-exact-caption1" font-weight=500 font-variant-numeric="tabular-nums" color="-exact-secondary-label" min-width="1rem" flex-shrink=0 text-align="end" aria-hidden=true
                              textarea value=queueDraft input=typeRow autofocus=true rows=1 field-sizing="content" max-height=88 aria-label="Message" font="-exact-subheadline" border="none" border-radius=10 background-color="light-dark(#ffffff, #111111)" padding="6px 10px" flex=1 min-width=0 testId="queue-edit-field"
                              button press=cancelRow appearance="none" min-height=44 flex-shrink=0 testId="queue-edit-cancel"
                                text "Cancel" font="-exact-subheadline" color="-exact-secondary-label"
                              button press=saveRow(q.id, q.text) disabled=(queueDraft.trim() == "") appearance="none" min-height=44 flex-shrink=0 opacity=(queueDraft.trim() == "" ? 0.4 : 1) testId="queue-edit-save"
                                text "Save" font="-exact-subheadline" font-weight=600 color="light-dark(#7a4e2d, #d4a574)"
                        else
                          QueueRow(q=q, first=(q.position == 1))
                // The slash menu (ComposerSlashMenu) over the box: a row for each command, model or effort, and a mark on
                // the one that every chat runs with. It shows only while the draft starts with a slash, so a chosen model
                // or effort, which empties the box, closes it.
                if slashing and slash.length > 0
                  column role="menu" aria-label="Commands" margin-bottom=8 border-radius=16 background-color="light-dark(#f4f4f4, #212121)" overflow="hidden" testId="slash-menu"
                    for s in slash key=s.id
                      button role="menuitem" appearance="none" press=pickSlash(s.kind, s.value) retainFocus=true display="flex" flex-direction="row" align-items="center" gap=10 padding="0px 14px" min-height=44 text-align="start" width="100%" box-sizing="border-box" testId=`slash-${s.id}`
                        image s.symbol width=20 height=20 color="-exact-secondary-label" aria-hidden=true
                        text s.title font="-exact-subheadline" font-weight=500 flex-shrink=0
                        text s.detail font="-exact-subheadline" color="-exact-secondary-label" line-clamp=1 flex=1 min-width=0
                        if s.chosen
                          image "symbol:checkmark" width=14 height=14 color="light-dark(#7a4e2d, #d4a574)" aria-label="Chosen"
                column position="relative" border-radius=24 background-color="light-dark(#f4f4f4, #212121)" testId="composer-box"
                  if attached.length > 0
                    row flex-wrap="wrap" gap=6 padding="10px 12px 0px 12px" testId="attachments"
                      for n in attached key=n.path
                        button appearance="none" press=detach(n.path) aria-label=`Remove ${n.name}` display="flex" flex-direction="row" align-items="center" gap=4 padding="4px 10px" border-radius=12 background-color="-exact-fill" testId=`attached-${n.name}`
                          text n.name font="-exact-footnote" line-clamp=1 max-width=160
                          image "symbol:close" width=10 height=10 aria-hidden=true
                  textarea id="chat-input" value=chatDraft input=editChat focus=focusChat blur=blurChat rows=1 field-sizing="content" max-height=140 placeholder=`Message ${chat.project}` aria-label="Message" border="none" background-color="transparent" min-width=0 padding-top=12 padding-bottom=(expanded ? 4 : 12) padding-left=(expanded ? 16 : 48) padding-right=(expanded ? 16 : 52) testId="chat-input"
                  // An open box keeps a row under the text for the plus and Send. The model and the effort have no chips
                  // there: `/model` and `/effort` change them, as in the Swift app.
                  if expanded
                    view height=44 testId="composer-toolbar"
                  // The plus: a file, or a photo of the library (ComposerAttachments).
                  button appearance="none" popovertarget="plus-menu" retainFocus=true aria-label="More options" position="absolute" left=6 bottom=6 width=32 height=32 border-radius=16 display="flex" align-items="center" justify-content="center" testId="composer-plus"
                    image "symbol:add" width=18 height=18
                  // Send and Stop (sendControls): Stop while the agent works, quiet when there is a draft and the
                  // filled button when there is none; Send when there is a draft.
                  row position="absolute" right=6 bottom=6 gap=4 align-items="center"
                    if chat.turn.running
                      button appearance="none" press=stopChat retainFocus=true aria-label="Stop" width=32 height=32 border-radius=16 background-color=(canSend ? "transparent" : "light-dark(#7a4e2d, #d4a574)") display="flex" align-items="center" justify-content="center" testId="composer-stop"
                        image "symbol:stop-fill" width=14 height=14 color=(canSend ? "-exact-secondary-label" : "-exact-background")
                    if canSend
                      button appearance="none" press=sendChat disabled=sending retainFocus=true aria-label="Send" width=32 height=32 border-radius=16 background-color="light-dark(#7a4e2d, #d4a574)" display="flex" align-items="center" justify-content="center" testId="composer-send"
                        image "symbol:send" width=16 height=16 color="-exact-background"
          if e.name == "new"
            column navigationKey=`${e.id}` navigationPresentation="modal" navigationScroll="new-form" position="absolute" inset=0 display="flex" flex-direction="column"
              header display="flex" align-items="center" justify-content="space-between" padding="8px 16px"
                button id="back" press=back aria-label="Cancel" testId="new-cancel"
                  image "symbol:close"
                text "New project" role="heading"
                button press=saveProject buttonStyle="bordered-prominent" aria-label="Save" disabled=(projectName.trim() == "" or pending(created)) testId="new-save"
                  image "symbol:checkmark"
              list id="new-form" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                section
                  row
                    input value=projectName input=editName placeholder="Name" aria-label="Name" autofocus=true submit=saveProject testId="new-name" flex=1 min-width=0
          // Edit draft (MessageDraftEditor): Via as it is, From and Reply to where the draft has them, To, Subject and the
          // message. Cancel and Save wait while a Save goes.
          if e.name == "draft"
            column navigationKey=`${e.id}` navigationPresentation="modal" navigationScroll="draft-form" position="absolute" inset=0 display="flex" flex-direction="column" testId="draft-editor"
              header display="flex" align-items="center" justify-content="space-between" padding="8px 16px"
                button id="back" press=back disabled=pending(draftSaved) aria-label="Cancel" testId="draft-cancel"
                  image "symbol:close"
                text "Edit draft" role="heading"
                button press=saveDraft buttonStyle="bordered-prominent" aria-label="Save" disabled=(not canSaveDraft) testId="draft-save"
                  image "symbol:checkmark"
              list id="draft-form" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                section
                  row
                    text "Via" flex=1
                    text editVia color="-exact-secondary-label" testId="draft-via"
                  if editHasFrom
                    row
                      input value=editFrom input=editFromField placeholder="From" aria-label="From" autocapitalize="none" autocorrect="off" spellcheck=false testId="draft-sender-field" flex=1 min-width=0
                  row
                    input value=editTo input=editToField placeholder="To" aria-label="To" autocapitalize="none" autocorrect="off" spellcheck=false testId="draft-recipient-field" flex=1 min-width=0
                  if editHasReplyTo
                    row
                      input value=editReplyTo input=editReplyToField placeholder="Reply to" aria-label="Reply to" autocapitalize="none" autocorrect="off" spellcheck=false testId="draft-reply-to-field" flex=1 min-width=0
                  row
                    input value=editSubject input=editSubjectField placeholder="Subject" aria-label="Subject" testId="draft-subject-field" flex=1 min-width=0
                section
                  row
                    textarea value=editBody input=editBodyField rows=10 field-sizing="content" min-height=220 aria-label="Message" testId="draft-body-field" flex=1 min-width=0
                  footer
                    text "Changes stay in the draft until you select Send."
                if editError != ""
                  section
                    row
                      text editError color="light-dark(#b84524, #fc855c)" testId="draft-error"
          // The photos full screen on black (PhotoViewer): Close, which of them is in view, the photo whole, its caption,
          // and the next and the last one.
          if e.name == "photo"
            column navigationKey=`${e.id}` navigationPresentation="fullscreen" position="absolute" inset=0 display="flex" flex-direction="column" color-scheme="dark" background-color="-exact-background" testId="photo-viewer"
              row align-items="center" gap=8 padding-top="env(safe-area-inset-top)" padding-left=8 padding-right=8 flex-shrink=0
                button press=back appearance="none" aria-label="Close" width=44 height=44 display="flex" align-items="center" justify-content="center" testId="viewer-close"
                  image "symbol:close" width=18 height=18 color="-exact-label"
                text (viewed.length > 1 ? `${viewAt + 1} of ${viewed.length}` : "") flex=1 text-align="center" font="-exact-subheadline" font-weight=600 font-variant-numeric="tabular-nums" color="-exact-label" testId="viewer-count"
                view width=44 height=44
              match viewed.at(viewAt)
                case some(p)
                  image p.full aria-label=(p.caption != "" ? p.caption : "Photo") flex=1 min-height=0 width="100%" object-fit="contain" testId="viewer-image"
                  if p.caption != ""
                    text p.caption font="-exact-subheadline" color="-exact-label" padding="12px 16px" testId="viewer-caption"
                case none
                  view flex=1
              row justify-content="space-between" padding-left=16 padding-right=16 padding-bottom="env(safe-area-inset-bottom)" min-height=44 flex-shrink=0
                if viewed.length > 1
                  button press=showPhoto(viewAt - 1) disabled=(viewAt == 0) appearance="none" aria-label="Previous photo" width=44 height=44 display="flex" align-items="center" justify-content="center" opacity=(viewAt == 0 ? 0.3 : 1) testId="viewer-previous"
                    image "symbol:back" width=18 height=18 color="-exact-label"
                  button press=showPhoto(viewAt + 1) disabled=(viewAt >= viewed.length - 1) appearance="none" aria-label="Next photo" width=44 height=44 display="flex" align-items="center" justify-content="center" opacity=(viewAt >= viewed.length - 1 ? 0.3 : 1) testId="viewer-next"
                    image "symbol:forward-chevron" width=18 height=18 color="-exact-label"
      // The picker of Home ends with New project.
      column id="project-menu" popover="auto" role="menu" aria-label="Project"
        for p in home.projects key=p.id
          button role="menuitemradio" aria-checked=(p.id == home.target.id) press=pickProject(p.id) popovertarget="project-menu" popovertargetaction="hide" testId=`project-${p.id}`
            text p.name
        // The Mac's projects are fixed (Coconut, Gumroad, Personal), so only the demo makes one.
        if not home.live
          hr
          button press=openNew popovertarget="project-menu" popovertargetaction="hide" testId="new-project"
            image "symbol:add"
            text "New project"
      // The plus of the composer: a file, or a photo (ComposerAttachments).
      column id="plus-menu" popover="auto" role="menu" aria-label="More options"
        button press=pickFile popovertarget="plus-menu" popovertargetaction="hide" testId="attach-file-item"
          image "symbol:sf/paperclip"
          text "Attach file"
        button press=pickPhoto popovertarget="plus-menu" popovertargetaction="hide" testId="attach-photo-item"
          image "symbol:photo"
          text "Photo library"
      // The menu of each queued message of the open chat, from the … of its row or a long press on the row. The roles
      // `send` and `download` draw arrow.up and arrow.down, as Swift's Move up and Move down.
      for q in chat.queue key=q.id
        column id=`queue-menu-${q.id}` popover="auto" role="menu" aria-label=`Queued message ${q.position}`
          if q.canSteer
            button press=steerRow(q.id) popovertarget=`queue-menu-${q.id}` popovertargetaction="hide" testId=`queue-steer-${q.position}`
              image "symbol:sf/arrow.turn.down.right"
              text "Send now"
          if chat.newAgent and q.canChange
            button press=newAgentRow(q.id) popovertarget=`queue-menu-${q.id}` popovertargetaction="hide" testId=`queue-new-agent-${q.position}`
              image "symbol:compose"
              text "Send to a new agent"
          if q.canChange
            button press=editRow(q.id, q.text) popovertarget=`queue-menu-${q.id}` popovertargetaction="hide" testId=`queue-edit-${q.position}`
              image "symbol:pencil"
              text "Edit"
          if q.canMoveUp
            button press=moveRow(q.id, -1) popovertarget=`queue-menu-${q.id}` popovertargetaction="hide" testId=`queue-up-${q.position}`
              image "symbol:send"
              text "Move up"
          if q.canMoveDown
            button press=moveRow(q.id, 1) popovertarget=`queue-menu-${q.id}` popovertargetaction="hide" testId=`queue-down-${q.position}`
              image "symbol:download"
              text "Move down"
          if q.canChange
            button press=removeRow(q.id) destructive=true popovertarget=`queue-menu-${q.id}` popovertargetaction="hide" testId=`queue-remove-${q.position}`
              image "symbol:delete"
              text "Remove"
      input type="file" id="attach-file" multiple=true display="none" change=pickedFiles testId="attach-file"
      input type="file" id="attach-photo" accept="image/*" multiple=true display="none" change=pickedPhotos testId="attach-photo"
