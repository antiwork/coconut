#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
for candidate in "${COCONUT_TEST_PYTHON:-}" python3.14 python3.13 python3.12 python3.11 python3; do
    if [ -n "$candidate" ] && "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 11))' >/dev/null 2>&1; then
        exec "$candidate" scripts/pre_commit.py
    fi
done
echo 'The local regression hook needs Python 3.11 or newer.' >&2
exit 1
