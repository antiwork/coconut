<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The dictation of a message box (Dictation.swift). The hardened runtime of a release opens the microphone only
         with this key. The app has no sandbox, so it needs no other key. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
