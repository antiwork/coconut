  "commands": {
    "preflight": [
      [
        "Command Line Tools check",
        [
          "/usr/bin/xcode-select",
          "-p"
        ]
      ],
      [
        "Compiler check",
        [
          "/usr/bin/xcrun",
          "--find",
          "clang"
        ]
      ],
      [
        "Git check",
        [
          "/usr/bin/git",
          "--version"
        ]
      ]
    ],
    "prepare": [
      [
        "Notification encryption build",
        [
          "python",
          "/Coconut/scripts/push.py",
          "--rebuild"
        ]
      ],
      [
        "Team helper build",
        [
          "python",
          "/Coconut/scripts/team.py",
          "build"
        ]
      ]
    ],
    "install": [
      [
        "Login item start",
        [
          "/bin/launchctl",
          "kickstart",
          "-k",
          "gui/<uid>/com.gumroad.coconut.service"
        ]
      ]
    ],
    "tunnel": [
      [
        "Tunnel sidecar build",
        [
          "python",
          "/Coconut/scripts/tunnel.py",
          "rebuild"
        ]
      ]
    ],
    "skills": [
      [
        "Hermes skill setup",
        [
          "python",
          "/Coconut/scripts/hermes_skills.py",
          "add"
        ]
      ]
    ],
    "hermes": [
      [
        "Hermes check",
        [
          "python",
          "/Coconut/scripts/host.py",
