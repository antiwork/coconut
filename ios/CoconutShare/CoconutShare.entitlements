<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The group that the app shares with its extensions holds the list of the chats (ShareDirectoryStore). The
         group of the app holds its pairing, which the extension only reads (SharePairing). -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)com.gumroad.coconut.push</string>
        <string>$(AppIdentifierPrefix)com.gumroad.coconut</string>
    </array>
</dict>
</plist>
